supported_targets = "native"

// `moonbitlang/core/bench` is only referenced from `*_bench_wbtest.mbt`; `moon
// check` does not type-check benchmark blocks, so the import looks unused there.
warnings = "-29"

import {
  "PingGuoMiaoMiao/LunarRender/renderer",
  "PingGuoMiaoMiao/LunarRenderNative/backend/opengl",
  "PingGuoMiaoMiao/LunarRenderNative/platform/native",
  "moonbitlang/core/env",
  "moonbitlang/core/math" @stdmath,
  "moonbitlang/core/bench",
}

pkgtype(kind: "executable")

options(
  link: {
    "native": {
      "cc-link-flags": "third_party/build/Release/lunarrender_glad.lib third_party/build/glfw/src/Release/glfw3.lib opengl32.lib user32.lib gdi32.lib shell32.lib windowscodecs.lib ole32.lib",
    },
  },
)
